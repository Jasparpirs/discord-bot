# Copy this file to ".env" and fill in your values. Never commit .env.

# Required
DISCORD_TOKEN=your-discord-bot-token

# Recommended on Railway — point this at a mounted Volume so giveaways, reviews,
# modmail, bookings and purchases survive redeploys. Set to the volume's mount path.
DATA_DIR=/data

# Optional — you (for the owner-only /optimizations command). Falls back to the guild owner.
OWNER_ID=

# Optional — staff role that can see + manage every ticket.
STAFF_ROLE_ID=

# Optional — category ID that ticket channels are created under.
TICKET_CATEGORY_ID=

# Optional — channel where /vouch reviews get posted.
REVIEWS_CHANNEL_ID=

# Optional — channel where ticket transcripts are logged when a ticket closes.
LOG_CHANNEL_ID=

# Optional — dedicated channel for modmail (user DMs -> private threads you reply
# in). Falls back to LOG_CHANNEL_ID if unset.
MODMAIL_CHANNEL_ID=

# Optional — role granted by the /verifypanel Verify button. Falls back to a
# role literally named "Verified".
VERIFY_ROLE_ID=

# Set to "on" for exact customer counts by role in /stats.
# NOTE: "Server Members Intent" (Developer Portal -> Bot) is REQUIRED for the bot
# to start at all, because the join welcome needs member-add events. Enable it
# there regardless of this flag; this flag only toggles the heavier full-member
# fetch inside /stats.
SERVER_MEMBERS_INTENT=

# --- Welcome (optional) ----------------------------------------------------
# Channel where a short welcome card is posted when a member joins. Falls back
# to LOG_CHANNEL_ID if left blank.
WELCOME_CHANNEL_ID=

# --- Scheduling (optional) -------------------------------------------------
# Customers book a remote session from inside their (paid) ticket. Sessions are
# spaced SLOT_HOURS apart so two never overlap — booking one slot locks out
# anything within that window (book 17:00 -> next free is 19:00).
SLOT_HOURS=2
# The timezone a customer's typed time is read in. BEST: set a real IANA zone
# (e.g. Europe/Tallinn, Europe/London, America/New_York) — then daylight saving
# is handled automatically and you never touch it again. Confirmations render as
# Discord timestamps, so every viewer still sees the time in their own clock.
SCHEDULE_TZ=Europe/Tallinn
# Fallback only — used if SCHEDULE_TZ above isn't a recognized IANA zone.
# Hours ahead of UTC (CET=1, CEST=2, UK winter=0). Leave as-is if using a zone.
SCHEDULE_UTC_OFFSET=0
# Minutes before a booked session to DM the customer a reminder (default 30).
REMIND_BEFORE_MIN=30

# --- Stripe automation (optional) -----------------------------------------
# When set, a webhook auto-assigns the package role after payment.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Your Discord server ID (right-click server -> Copy Server ID). Optional if the
# bot is only in one server.
GUILD_ID=
# PORT is provided automatically by Railway; no need to set it yourself.
